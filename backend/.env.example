# ==========================================
# TerraGuard NE Backend Environment Configuration
# ==========================================

ENV=development
PROJECT_NAME="TerraGuard NE"
VERSION=1.0.0

# Database URL:
# For local zero-setup execution:
DATABASE_URL=sqlite:///./terraguard.db
# For production PostgreSQL / PostGIS container:
# DATABASE_URL=postgresql+psycopg2://postgres:terraguard_secure_pass@localhost:5432/terraguard

# Security Secrets
SECRET_KEY=terraguard_super_secret_production_key_dikrong_2026

# Weather API Configuration
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Telecom SMS Gateway (Optional - falls back to internal simulation)
SMS_API_KEY=
SMS_SENDER_ID=TERRAG

# Native HEC-RAS 2D (Optional - falls back to calibrated hydrodynamic solver)
HECRAS_EXE_PATH=C:\Program Files (x86)\HEC\HEC-RAS\6.4.1\Ras.exe
ENABLE_HECRAS_NATIVE=false
